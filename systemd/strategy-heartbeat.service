# Server unit. Pulled in by strategy-heartbeat.timer; not enabled on its own (no [Install] section).
# Deliberately runs as root: the strategy cron it watches also runs as root from /root/apps.
[Unit]
Description=Invest Tinkoff Bot strategy heartbeat watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Environment=HOME=/root
WorkingDirectory=/root/apps/invest_tinkoff_bot
EnvironmentFile=/etc/invest_tinkoff_bot.env
ExecStart=/usr/bin/flock -n /tmp/invest_tinkoff_bot-strategy-heartbeat.lock /root/apps/invest_tinkoff_bot/bin/systemd_exec rake strategy:heartbeat
