# Server (runs market-cache-refresh.timer, cache-health.timer and strategy-heartbeat.timer).
# Copy to /etc/invest_tinkoff_bot.env and set permissions:
#   sudo install -m 0600 -o root -g root systemd/invest_tinkoff_bot.server.env.example /etc/invest_tinkoff_bot.env
# Never create a working invest_tinkoff_bot.env inside the repository.
# MOEX_SYNC_* variables are NOT needed on the server (sync is pushed from the local machine).

TINKOFF_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# T-Invest serves a chain rooted in Russian Trusted Root CA (Mincifry), which is
# in neither the system store nor the grpc gem's bundled roots.pem — without this
# every gRPC call dies with CERTIFICATE_VERIFY_FAILED. Point it at a bundle of
# roots.pem + that root; see scripts/setup_ru_ca.sh. grpc-core reads this variable
# and nothing else does, so OpenSSL/Net::HTTP (Telegram, MOEX) keep the system
# roots and the extra CA is confined to the broker channel.
GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/etc/ssl/invest_bot/roots_with_ru.pem

# Market cache refresh
# Keep SCAN_MAX_LOT_RUB >= MAX_LOT_RUB used by the strategy, otherwise valid
# instruments are silently dropped at cache stage (code default is only 500).
SCAN_MAX_LOT_RUB=2000
INSTRUMENT_CACHE_HOURS=24
MARKET_CACHE_SLEEP=

# Cache health watchdog thresholds
CACHE_WARN_AGE_HOURS=36
CACHE_CRITICAL_AGE_HOURS=60
INTERSECTION_CACHE_MAX_AGE_HOURS=72
CACHE_ALERT_REPEAT_HOURS=12

# Strategy heartbeat watchdog thresholds (strategy-heartbeat.timer, every 10 min).
# The strategy cron writes its log every 5 minutes around the clock, so silence
# longer than a few runs means the loop is stuck — see README, Strategy liveness watchdog.
STRATEGY_HEARTBEAT_WARN_MINUTES=20
STRATEGY_HEARTBEAT_CRITICAL_MINUTES=60
STRATEGY_HEARTBEAT_REPEAT_HOURS=6
STRATEGY_HUNG_RUN_MINUTES=15

# Per-RPC deadline for the broker client, in seconds. Without it a broken channel
# hangs a run forever and flock then silently skips every later cron start.
INVEST_TINKOFF_GRPC_TIMEOUT=30

# Daily trade report (bin/daily_trade_report.rb, cron at 16:05 UTC = 21:05 YEKT).
# Rolling-24h window ending at the cutoff; reuses TELEGRAM_* above unless overridden.
DAILY_REPORT_UTC_OFFSET=+05:00
DAILY_REPORT_TIME_LABEL=YEKT
DAILY_REPORT_CUTOFF=21:00
DAILY_REPORT_INDEX=IMOEX
